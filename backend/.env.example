# GeoGuard Backend Configuration

# Provider selection: "mock" (offline demo mode) or "geoseer" (live API)
GEOLOCATION_PROVIDER=mock

# GeoSeer API credentials (required only when GEOLOCATION_PROVIDER=geoseer)
GEOSEER_API_KEY=
GEOSEER_API_URL=https://geoseeer.com/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,heic
API_TIMEOUT_SECONDS=60
