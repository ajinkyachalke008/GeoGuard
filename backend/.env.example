# GeoGuard Backend Environment Configuration
GEOLOCATION_PROVIDER=gemini

# Google Gemini API (Recommended: World-class spatial perception & visual reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenRouter API (GPT-4o, Claude 3.5, Gemini via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Direct OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic Claude Direct API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GeoSeer API
GEOSEER_API_KEY=your_geoseer_api_key_here
GEOSEER_API_URL=https://geoseeer.com/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,heic
API_TIMEOUT_SECONDS=60
